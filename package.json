{
  "name": "focusflow-frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i static/css/tailwind.input.css -o static/css/tailwind.css --minify",
    "build:js": "esbuild static/js/index.js --bundle --minify --format=esm --outfile=static/js/app.js"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.14.9",
    "htmx.org": "1.9.12"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
